# ==============================================================================
# Seva Setu (.gitignore) - Production Netlify & GitHub Configuration
# ==============================================================================

# Large Media & Video Files (>100MB violates GitHub hard push limit)
*.mp4
*.mov
*.avi
*.wmv
*.mkv
*.webm
Recording*.mp4

# Node & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Netlify Build Outputs & Local CLI Cache
.netlify/
.netlify-dev/

# Python, Bytecode & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/

# Environment Variables, Secrets & Local Credentials
.env
.env.local
.env.*.local
*.pem
*.key
*.cert

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# IDEs & Editors
.idea/
*.swp
*.swo
*~
.claude/
Claude outputs/
