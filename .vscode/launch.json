{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Frontend in Chrome (Port 5500)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5500",
            "webRoot": "${workspaceFolder}/frontend"
        },
        {
            "name": "FastAPI: Run Backend (Port 8000)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "main:app",
                "--app-dir",
                "${workspaceFolder}/backend",
                "--host",
                "0.0.0.0",
                "--port",
                "8000",
                "--reload"
            ],
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "jinja": true,
            "justMyCode": true
        }
    ],
    "compounds": [
        {
            "name": "Full Stack: Frontend + Backend",
            "configurations": [
                "FastAPI: Run Backend (Port 8000)",
                "Launch Frontend in Chrome (Port 5500)"
            ]
        }
    ]
}